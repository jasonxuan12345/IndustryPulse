{
  "$defs": {
    "JobState": {
      "description": "任务状态（§7.2 job_run.state）。",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "skipped",
        "retrying"
      ],
      "title": "JobState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "任务运行状态（§7.2 job_run）。幂等键见 §16。",
  "properties": {
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "job_name": {
      "minLength": 1,
      "title": "Job Name",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/JobState"
    },
    "start_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start At"
    },
    "end_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End At"
    },
    "retry_count": {
      "default": 0,
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    }
  },
  "required": [
    "job_id",
    "job_name",
    "state"
  ],
  "title": "JobStatus",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrypulse.local/contracts/1.0.0/research.JobStatus.schema.json",
  "x-contracts-version": "1.0.0"
}

# Copy to .env; scripts/start_dashboard.py loads it. Never commit real keys.
# Leave blank to configure the model in the browser's settings page.
INDUSTRYPULSE_MODEL_BASE_URL=
INDUSTRYPULSE_MODEL_API_KEY=
INDUSTRYPULSE_MODEL_NAME=
INDUSTRYPULSE_MODEL_PROTOCOL=

# Example: DeepSeek base https://api.deepseek.com/v1 with its actual /models ID.
# Independent search key is required when model and search origins differ.
INDUSTRYPULSE_SEARCH_URL=https://api.deepseek.com/v1/tools/search
INDUSTRYPULSE_FETCH_URL=https://api.deepseek.com/v1/tools/fetch
INDUSTRYPULSE_SEARCH_KEY=

INDUSTRYPULSE_DASHBOARD_DB=data/g2.duckdb
INDUSTRYPULSE_NEWS_AUTO_FETCH=1
INDUSTRYPULSE_MARKET_DATA=1
